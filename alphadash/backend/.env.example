# Copy to .env for local development. Never commit .env.
# All keys are prefixed ALPHADASH_ (see config.py).

ALPHADASH_APP_ENV=development
ALPHADASH_TRADING_MODE=paper
ALPHADASH_DATABASE_URL=sqlite:///./alphadash.db
# JSON array; the Vite dev server origin by default.
ALPHADASH_CORS_ORIGINS=["http://localhost:5173"]
