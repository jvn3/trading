# Copy to .env for local development. Never commit .env.
# All keys are prefixed ALPHADASH_ (see config.py).

ALPHADASH_APP_ENV=development
ALPHADASH_TRADING_MODE=paper

# Dev on Postgres (docker compose -f ../docker-compose.yml up -d). IMPORTANT: the app must use
# the non-superuser role or RLS silently does nothing. Migrations run as `alphadash` (owner).
ALPHADASH_DATABASE_URL=postgresql+psycopg://alphadash_app:alphadash_app_dev@localhost:5433/alphadash
# sqlite fallback (unit tests / quick hacking — no RLS):
# ALPHADASH_DATABASE_URL=sqlite:///./alphadash.db

# JSON array; the Vite dev server origin by default.
ALPHADASH_CORS_ORIGINS=["http://localhost:5173"]

# Market data: stub (deterministic fixtures) or real (jay_trading-backed FMP/FRED).
ALPHADASH_PROVIDERS=stub
# ALPHADASH_FMP_API_KEY=...   # optional; falls back to FMP_API_KEY in the repo root .env

# --- LLM (S2.3): fake | anthropic | openai | github ---
# fake = deterministic rule-based model, zero cost, works offline (default until keys exist).
ALPHADASH_LLM_PROVIDER=fake
# ALPHADASH_ANTHROPIC_API_KEY=sk-ant-...   # or bare ANTHROPIC_API_KEY; model claude-opus-4-8
# ALPHADASH_OPENAI_API_KEY=sk-...          # or bare OPENAI_API_KEY; model gpt-4o
# ALPHADASH_GITHUB_TOKEN=github_pat_...    # or bare GITHUB_TOKEN (models:read); GitHub Models
# ALPHADASH_ANTHROPIC_MODEL=claude-opus-4-8
# ALPHADASH_OPENAI_MODEL=gpt-4o
# ALPHADASH_GITHUB_MODEL=openai/gpt-4o
